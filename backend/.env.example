# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=aids_portal
DB_PORT=3306

# Prisma Database URL
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/aids_portal"

# JWT Secret & Cookie Configuration
JWT_SECRET=super_secret_jwt_key_aids_portal_2026_department_system
JWT_EXPIRES_IN=7d
COOKIE_SECRET=department_cookie_secret_aids_2026

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_EMAIL=admin.aids@college.edu

# File storage provider: supabase (now) or r2 (later)
STORAGE_PROVIDER=supabase

# Supabase Storage (private bucket) - backend only, never expose to frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=aids-portal-files

# Cloudflare R2 Object Storage (For future switch via STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=aids-portal-files
