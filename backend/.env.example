# Server Configuration
PORT=5000
NODE_ENV=development
TRUST_PROXY=1

# Database Configuration (MySQL / TiDB Cloud)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_NAME=aids_portal
DB_PORT=3306
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Prisma Database URL
DATABASE_URL="mysql://root:CHANGE_ME_DATABASE_PASSWORD@localhost:3306/aids_portal"

# JWT Secret & Cookie Configuration (Use 64+ random characters in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_KEY
COOKIE_SECRET=CHANGE_ME_GENERATE_RANDOM_COOKIE_SECRET

# Application-Layer AES-256-GCM Field Encryption Key (64 hex characters / 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS_FOR_AES_256_GCM_ENCRYPTION

# Client URL (for CORS, comma-separated for multiple exact domains)
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DEFAULT_ADMIN_EMAIL=aamecaidsskill@gmail.com

# File storage provider: supabase or r2
STORAGE_PROVIDER=supabase

# Supabase Storage (private bucket) - backend only, never expose to frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_BUCKET=aids-portal-files

# Cloudflare R2 Object Storage (For switch via STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=aids-portal-files

# Email Automation (Brevo HTTPS REST API)
# Render free tier blocks outbound SMTP; Brevo v3 HTTPS API is used directly.
MAIL_ENABLED=false
REQUIRE_EMAIL_VERIFICATION=true
BREVO_API_KEY=your_brevo_v3_api_key_here
# Note: MAIL_FROM_EMAIL must match a verified sender address configured in your Brevo dashboard
MAIL_FROM_EMAIL=your_verified_sender@example.com
MAIL_FROM_NAME="AI & DS Portal - AAMEC"
MAIL_REPLY_TO=support@example.com
# Set to false to attach only the masked PDF application summary (recommended for document privacy)
MAIL_ATTACH_DOCUMENTS=false
MAIL_MAX_ATTACHMENT_BYTES=3000000
MAIL_DAILY_LIMIT=250
PORTAL_URL=https://aamec-ai-ds-portal.vercel.app
